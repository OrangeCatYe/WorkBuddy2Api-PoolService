{
  "listen": "127.0.0.1:7863",
  "data_dir": "./data",
  "admin_key": "adm-change-me",
  "credits": {
    "strategy": "waste_first",
    "waste_boost": 4,
    "expensive_rate": 0.5,
    "daily_cap": 0,
    "reserve": 0,
    "burn_window_days": 7
  },
  "gateway": {
    "model_naming": "short",
    "catalog_ttl": "10m",
    "credit_in_model_name": false,
    "legacy_api_key": "sk-change-me",
    "allow_anonymous": false
  },
  "update": {
    "source": "github",
    "proxy": "",
    "auto_check": false,
    "check_interval": "24h"
  },
  "providers": {
    "workbuddy": {
      "enabled": true,
      "auth_dir": "",
      "state_file": "",
      "pool": {
        "max_in_flight": 3,
        "prefer_expiring": true,
        "expiring_soon": "168h",
        "credit_floor": 0
      },
      "schedule": {
        "checkin_hours": [9, 21],
        "checkin_enabled": true,
        "keepalive_enabled": true,
        "balance_refresh_minutes": 5,
        "package_refresh_minutes": 30
      },
      "global": { "enabled": true },
      "prompt": { "mode": "passthrough" },
      "session_sticky": { "enabled": true, "ttl": "30m" }
    }
  }
}
